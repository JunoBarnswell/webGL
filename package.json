{
  "name": "webgl-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/extensions/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @studio/editor",
    "dev:player": "npm run dev -w @studio/player",
    "build": "npm run build -w @studio/editor && npm run build -w @studio/player",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages/scene-schema packages/scene-runtime packages/editor-core packages/asset-pipeline packages/player-ui packages/extensions scripts --max-warnings 0",
    "import:showroom": "node --import tsx scripts/import-showroom.mts",
    "verify:integration": "node --import tsx scripts/verify-integration.mts",
    "verify:contracts": "node --import tsx scripts/verify-contracts.mts",
    "package:linux": "bash scripts/package-linux.sh",
    "verify:experience": "node --import tsx scripts/verify-experience.mts",
    "schema:generate": "node --import tsx scripts/compose-extensions.mts",
    "prebuild": "npm run schema:generate",
    "verify:extensions": "node --import tsx scripts/verify-extensions.mts",
    "verify:browser": "node --import tsx scripts/verify-browser.mts",
    "benchmark:studio": "node --import tsx scripts/benchmark-studio.mts",
    "examples:industry": "node --import tsx scripts/create-industry-samples.mts",
    "verify:delivery": "node --import tsx scripts/verify-delivery.mts",
    "verify:model-revision": "node --import tsx scripts/verify-model-revision.mts",
    "verify:studio22": "node --import tsx scripts/verify-studio22.mts"
  },
  "dependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "ajv": "^8.17.1",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "immer": "11.1.21",
    "lucide-react": "^0.468.0",
    "meshoptimizer": "0.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.160.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "playwright-core": "1.58.2",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.1.0"
  }
}
