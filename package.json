{
  "name": "webgl-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @studio/editor",
    "dev:player": "npm run dev -w @studio/player",
    "build": "npm run build -w @studio/editor && npm run build -w @studio/player",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages/scene-schema packages/scene-runtime packages/editor-core packages/asset-pipeline scripts --max-warnings 0",
    "import:showroom": "node scripts/import-showroom.mjs",
    "verify:integration": "node scripts/verify-integration.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1", "dockview-react": "^4.0.0", "idb": "^8.0.3",
    "lucide-react": "^0.468.0", "react": "^19.0.0", "react-dom": "^19.0.0",
    "three": "0.160.1", "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "@types/three": "^0.160.0", "@vitejs/plugin-react": "^4.3.4", "eslint": "^9.0.0",
    "typescript": "^5.7.3", "typescript-eslint": "^8.0.0", "vite": "^6.1.0"
  }
}
