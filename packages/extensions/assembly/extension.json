{
  "manifest": {
    "id": "studio.assembly",
    "version": "2.0.0",
    "minRuntimeVersion": "2.0.0",
    "dependsOn": {},
    "permissions": []
  },
  "components": {
    "studio.assembly.Part": {
      "title": "装配零件",
      "fields": {
        "partNo": {
          "type": "string",
          "title": "零件号",
          "default": ""
        },
        "sourceElementId": {
          "type": "string",
          "title": "来源元素",
          "default": "",
          "x-source-element-id": true
        },
        "groupId": {
          "type": "string",
          "title": "装配组",
          "default": "",
          "x-reference": "entity",
          "x-target-components": [
            "studio.assembly.Root",
            "studio.assembly.Group"
          ],
          "x-required-publish": true,
          "x-public": false
        },
        "stages": {
          "type": "array",
          "title": "拆解步骤",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "title": "步骤 ID",
                "default": "",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$",
                "x-editor": "uuid"
              },
              "name": {
                "type": "string",
                "title": "步骤名称",
                "default": "拆解步骤"
              },
              "start": {
                "type": "number",
                "title": "开始",
                "default": 0,
                "minimum": 0,
                "maximum": 1,
                "x-less-than": "end"
              },
              "end": {
                "type": "number",
                "title": "结束",
                "default": 1,
                "minimum": 0,
                "maximum": 1
              },
              "path": {
                "type": "array",
                "title": "路径控制点 mm（起点为基准姿态）",
                "items": {
                  "type": "array",
                  "title": "向量",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [0, 0, 0],
                  "x-editor": "vector",
                  "x-coordinate": "parent-offset"
                },
                "minItems": 1,
                "default": [[500, 0, 0]]
              },
              "rotation": {
                "type": "array",
                "title": "相对旋转 °",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "default": [0, 0, 0],
                "x-editor": "vector"
              },
              "scale": {
                "type": "array",
                "title": "相对缩放",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "default": [1, 1, 1],
                "x-editor": "vector"
              },
              "easing": {
                "type": "string",
                "title": "缓动",
                "default": "smooth",
                "enum": ["linear", "smooth", "ease-in", "ease-out"]
              },
              "trail": {
                "type": "boolean",
                "title": "显示轨迹",
                "default": false
              },
              "visibility": {
                "type": "string",
                "title": "步骤结束后可见性",
                "enum": ["inherit", "show", "hide"],
                "default": "inherit"
              }
            },
            "required": [
              "id",
              "name",
              "start",
              "end",
              "path",
              "rotation",
              "scale",
              "easing",
              "trail",
              "visibility"
            ]
          },
          "default": [
            {
              "id": "initial",
              "name": "拆解步骤",
              "start": 0,
              "end": 1,
              "path": [[500, 0, 0]],
              "rotation": [0, 0, 0],
              "scale": [1, 1, 1],
              "easing": "smooth",
              "trail": false,
              "visibility": "inherit"
            }
          ],
          "x-unique-by": "id",
          "x-public": false
        },
        "attributes": {
          "type": "object",
          "title": "BOM 属性",
          "default": {},
          "x-editor": "json"
        }
      }
    },
    "studio.assembly.Root": {
      "title": "装配序列",
      "fields": {
        "duration": {
          "type": "number",
          "title": "时长 s",
          "default": 5,
          "minimum": 0.01
        },
        "loop": {
          "type": "boolean",
          "title": "循环",
          "default": false
        }
      }
    },
    "studio.assembly.Group": {
      "title": "装配分组",
      "fields": {
        "rootId": {
          "type": "string",
          "title": "装配序列",
          "default": "",
          "x-reference": "entity",
          "x-target-component": "studio.assembly.Root",
          "x-required-publish": true
        },
        "groupNo": {
          "type": "string",
          "title": "组号",
          "default": ""
        },
        "description": {
          "type": "string",
          "title": "说明",
          "default": ""
        }
      }
    }
  },
  "actions": {
    "studio.assembly.SetProgress": {
      "title": "装配进度",
      "target": "entity",
      "components": ["studio.assembly.Root"],
      "fields": {
        "progress": {
          "type": "number",
          "title": "进度",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "x-runtime-binding": "progress"
        }
      }
    },
    "studio.assembly.Play": {
      "title": "播放拆解",
      "target": "entity",
      "components": ["studio.assembly.Root"],
      "fields": {}
    },
    "studio.assembly.Pause": {
      "title": "暂停拆解",
      "target": "entity",
      "components": ["studio.assembly.Root"],
      "fields": {}
    },
    "studio.assembly.Restore": {
      "title": "恢复装配",
      "target": "entity",
      "components": ["studio.assembly.Root"],
      "fields": {}
    },
    "studio.assembly.SelectStep": {
      "title": "选择装配步骤",
      "target": "entity",
      "components": ["studio.assembly.Root"],
      "fields": {
        "stepId": {
          "type": "string",
          "title": "步骤 ID",
          "default": "",
          "x-required-publish": true,
          "x-options": {
            "component": "studio.assembly.Part",
            "relation": "groupId",
            "rootComponent": "studio.assembly.Group",
            "rootField": "rootId",
            "array": "stages",
            "value": "id",
            "label": "name",
            "sort": "start"
          }
        }
      }
    },
    "studio.assembly.HighlightPart": {
      "title": "高亮零件",
      "target": "entity",
      "components": ["studio.assembly.Part", "studio.assembly.Group"],
      "fields": {}
    },
    "studio.assembly.IsolatePart": {
      "title": "隔离零件",
      "target": "entity",
      "components": ["studio.assembly.Part", "studio.assembly.Group"],
      "fields": {}
    },
    "studio.assembly.FocusPart": {
      "title": "聚焦零件",
      "target": "entity",
      "components": [
        "studio.assembly.Part",
        "studio.assembly.Group",
        "studio.assembly.Root"
      ],
      "fields": {}
    }
  }
}
