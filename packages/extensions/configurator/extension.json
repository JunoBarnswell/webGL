    "minRuntimeVersion": "2.2.0",
    "dependsOn": {},
    "permissions": [],
    "contributions": {
      "workspaces": [
        "configurator"
      ],
      "documentKinds": [
        "studio.configurator.Catalog"
      ],
      "compilerPasses": [],
      "playerWidgets": [
        "configurator"
      ]
    }
  },
  "components": {
    "studio.configurator.Catalog": {
      "title": "产品配置Catalog",
      "fields": {
        "catalogId": {
          "type": "string",
          "title": "稳定 ID",
          "default": "",
          "x-editor": "uuid"
        },
        "revision": {
          "type": "string",
          "title": "目录版本",
          "default": "1"
        },
        "name": {
          "type": "string",
          "title": "产品名称",
          "default": "产品配置"
        },
        "market": {
          "type": "string",
          "title": "市场",
          "default": "CN"
        },
        "groups": {
          "type": "array",
          "title": "属性组",
