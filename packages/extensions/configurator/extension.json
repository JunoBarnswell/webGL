                  "optionId": {
                    "type": "string",
                    "title": "选项 ID",
                    "default": ""
                  }
                },
                "required": [
                  "groupId",
                  "optionId"
                ],
                "additionalProperties": false
              },
              "then": {
                "type": "object",
                "title": "",
                "properties": {
                  "groupId": {
                    "type": "string",
                    "title": "属性组 ID",
                    "default": ""
                  },
                  "optionId": {
                    "type": "string",
                    "title": "选项 ID",
                    "default": ""
                  }
