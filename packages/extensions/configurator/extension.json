                        "color",
                        "opacity",
                        "transform",
                        "variant",
                        "swapPart",
                        "camera"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "title": "值",
                      "default": "true"
                    },
                    "transform": {
                      "type": "object",
                      "title": "",
                      "properties": {
                        "position": {
                          "type": "array",
