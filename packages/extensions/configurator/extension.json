              "id": {
                "type": "string",
                "title": "稳定 ID",
                "default": "",
                "x-editor": "uuid"
              },
              "name": {
                "type": "string",
                "title": "属性名称",
                "default": "外观"
              },
              "control": {
                "type": "string",
                "title": "控件",
