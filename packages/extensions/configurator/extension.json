                            "type": "number",
                            "title": "",
                            "default": 0
                          },
                          "default": [
                            0,
                            0,
                            0
                          ],
                          "minItems": 3,
                          "maxItems": 3,
                          "x-editor": "vector"
                        },
                        "fov": {
                          "type": "number",
                          "title": "FOV",
                          "default": 60,
                          "minimum": 10,
