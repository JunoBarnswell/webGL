  "actions": {
    "studio.configurator.Select": {
      "title": "产品配置Select",
      "target": "entity",
      "components": [
        "studio.configurator.Catalog"
      ],
      "fields": {
        "groupId": {
          "type": "string",
          "title": "属性组",
          "default": ""
        },
        "optionId": {
          "type": "string",
          "title": "选项",
          "default": ""
        }
      }
    },
    "studio.configurator.Reset": {
      "title": "产品配置Reset",
      "target": "entity",
      "components": [
        "studio.configurator.Catalog"
      ],
      "fields": {}
    },
    "studio.configurator.SetNumber": {
      "title": "设置产品数值",
      "target": "entity",
      "components": [
        "studio.configurator.Catalog"
      ],
      "fields": {
        "groupId": {
          "type": "string",
          "title": "数值属性组",
          "default": ""
        },
        "value": {
          "type": "number",
          "title": "数值",
          "default": 0
        }
      }
