{
  "manifest": {
    "id": "studio.annotation",
    "version": "2.0.0",
    "minRuntimeVersion": "2.0.0",
    "dependsOn": {},
    "permissions": []
  },
  "components": {
    "studio.annotation.Label": {
      "title": "空间标注",
      "fields": {
        "anchorKind": {
          "type": "string",
          "title": "锚点",
          "default": "entity-local",
          "enum": [
            "world",
            "entity-local",
            "surface",
            "path-station"
          ]
        },
        "entityId": {
          "type": "string",
          "title": "附着对象",
          "default": "",
          "x-reference": "entity"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0,
            0,
            0
          ],
          "x-editor": "vector",
          "title": "锚点位置"
        },
        "sourceElementId": {
          "type": "string",
          "title": "来源元素",
          "default": "",
          "x-required-when": {
            "field": "anchorKind",
            "value": "surface"
          }
        },
        "meshRevision": {
          "type": "string",
          "title": "网格版本",
          "default": "",
          "x-required-when": {
            "field": "anchorKind",
            "value": "surface"
          }
        },
        "triangleIndex": {
          "type": "number",
          "title": "三角形",
          "default": 0,
          "minimum": 0
        },
        "barycentric": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            1,
            0,
            0
          ],
          "x-editor": "vector",
          "title": "重心坐标"
        },
        "routeId": {
          "type": "string",
          "title": "路径",
          "default": "",
          "x-reference": "entity",
          "x-target-component": "studio.piping.Segment",
          "x-required-when": {
            "field": "anchorKind",
            "value": "path-station"
          }
        },
        "station": {
          "type": "number",
          "title": "里程",
          "default": 0,
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string",
          "title": "标签",
          "default": "标注"
        },
        "contentId": {
          "type": "string",
          "title": "内容",
          "default": "",
          "x-reference": "content"
        },
        "color": {
          "type": "string",
          "title": "颜色",
          "default": "#56d6bd"
        },
        "size": {
          "type": "number",
          "title": "字号",
          "default": 14,
          "minimum": 10,
          "maximum": 48
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            40,
            -40,
            0
          ],
          "x-editor": "vector",
          "title": "引线偏移"
        },
        "maxDistance": {
          "type": "number",
          "title": "显示距离 mm",
          "default": 100000,
          "minimum": 1
        },
        "occlusion": {
          "type": "boolean",
          "title": "遮挡检测",
          "default": false
        }
      }
    }
  },
  "actions": {}
}
