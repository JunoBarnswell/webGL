{
  "manifest": {
    "id": "studio.annotation",
    "version": "2.0.0",
    "minRuntimeVersion": "2.0.0",
    "dependsOn": {},
    "permissions": []
  },
  "components": {
    "studio.annotation.Label": {
      "title": "空间标注",
      "fields": {
        "anchorKind": {
          "type": "string",
          "title": "锚点",
          "default": "entity-local",
          "enum": ["world", "entity-local", "surface", "path-station"],
          "x-resets": [
            "entityId",
            "position",
            "sourceElementId",
            "meshRevision",
            "triangleIndex",
            "barycentric",
            "primitiveIndex",
            "routeId",
            "station"
          ]
        },
        "entityId": {
          "type": "string",
          "title": "附着对象",
          "default": "",
          "x-reference": "entity",
          "x-reference-when": {
            "field": "anchorKind",
            "values": ["entity-local", "surface"]
          },
          "x-required-when": {
            "field": "anchorKind",
            "value": "surface"
          },
          "x-resets": [
            "sourceElementId",
            "meshRevision",
            "triangleIndex",
            "barycentric",
            "primitiveIndex"
          ]
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 0, 0],
          "x-editor": "vector",
          "title": "锚点位置",
          "x-visible-when": {
            "field": "anchorKind",
            "values": ["world", "entity-local"]
          }
        },
        "sourceElementId": {
          "type": "string",
          "title": "来源元素",
          "default": "",
          "x-required-when": {
            "field": "anchorKind",
            "value": "surface"
          },
          "x-visible-when": {
            "field": "anchorKind",
            "values": ["surface"]
          }
        },
        "meshRevision": {
          "type": "string",
          "title": "网格版本",
          "default": "",
          "x-required-when": {
            "field": "anchorKind",
            "value": "surface"
          },
          "x-visible-when": {
            "field": "anchorKind",
            "values": ["surface"]
          }
        },
        "triangleIndex": {
          "type": "integer",
          "title": "三角形",
          "default": 0,
          "minimum": 0,
          "x-visible-when": {
            "field": "anchorKind",
            "values": ["surface"]
          }
        },
        "barycentric": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [1, 0, 0],
          "x-editor": "vector",
          "title": "重心坐标",
          "x-sum": 1,
          "x-visible-when": {
            "field": "anchorKind",
            "values": ["surface"]
          }
        },
        "routeId": {
          "type": "string",
          "title": "路径",
          "default": "",
          "x-reference": "entity",
          "x-target-component": "studio.piping.Segment",
          "x-required-when": {
            "field": "anchorKind",
            "value": "path-station"
          },
          "x-reference-when": {
            "field": "anchorKind",
            "values": ["path-station"]
          }
        },
        "station": {
          "type": "number",
          "title": "里程",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "x-visible-when": {
            "field": "anchorKind",
            "values": ["path-station"]
          }
        },
        "label": {
          "type": "string",
          "title": "标签",
          "default": "标注"
        },
        "contentId": {
          "type": "string",
          "title": "内容",
          "default": "",
          "x-reference": "content"
        },
        "color": {
          "type": "string",
          "title": "颜色",
          "default": "#56d6bd"
        },
        "size": {
          "type": "number",
          "title": "字号",
          "default": 14,
          "minimum": 10,
          "maximum": 48
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [40, -40, 0],
          "x-editor": "vector",
          "title": "引线偏移"
        },
        "maxDistance": {
          "type": "number",
          "title": "显示距离 mm",
          "default": 100000,
          "minimum": 1
        },
        "occlusion": {
          "type": "boolean",
          "title": "遮挡检测",
          "default": false
        },
        "primitiveIndex": {
          "type": "integer",
          "title": "网格图元",
          "default": 0,
          "minimum": 0,
          "x-visible-when": {
            "field": "anchorKind",
            "values": ["surface"]
          }
        },
        "style": {
          "type": "string",
          "title": "标注样式",
          "default": "callout",
          "enum": ["callout", "badge", "measurement"]
        },
        "bindProperty": {
          "type": "string",
          "title": "属性绑定字段",
          "default": ""
        },
        "cluster": {
          "type": "boolean",
          "title": "允许聚合",
          "default": true
        }
      },
      "anchor": true
    }
  },
  "actions": {
    "studio.annotation.Focus": {
      "title": "聚焦标注",
      "target": "entity",
      "components": ["studio.annotation.Label"],
      "fields": {
        "duration": {
          "type": "number",
          "title": "秒",
          "default": 1,
          "minimum": 0.1,
          "maximum": 30
        }
      }
    }
  }
}
