FROM golang:1.24.7-bookworm@sha256:b8bae5bd9ba9b1f89b635c91c24cc75cea335a16fb5076310f38566fc674b1ec AS build
ARG MINIO_REF=RELEASE.2025-09-07T16-13-09Z
WORKDIR /source
RUN --mount=type=secret,id=proxy_ca,target=/run/proxy-ca.pem \
    if [ -f /run/proxy-ca.pem ]; then export SSL_CERT_FILE=/run/proxy-ca.pem GIT_SSL_CAINFO=/run/proxy-ca.pem; fi; \
    git init && git remote add origin https://github.com/minio/minio.git && \
    git fetch --depth=1 origin refs/tags/${MINIO_REF} && git checkout FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "07c3a429bfed433e49018cb0f78a52145d4bedeb" && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/minio . && git rev-parse HEAD > /out/source-commit
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /out/source-commit /usr/share/minio-source-commit
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
